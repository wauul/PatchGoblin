FROM node:24-bookworm-slim AS javascript
WORKDIR /deps
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM python:3.12-slim-bookworm
WORKDIR /app
COPY --from=javascript /usr/local/bin/node /usr/local/bin/node
COPY --from=javascript /deps/node_modules ./node_modules
RUN pip install --no-cache-dir uv==0.8.22
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY worker ./worker
COPY scripts/railway-sandbox-bridge.mjs ./scripts/railway-sandbox-bridge.mjs
ENV PORT=8080 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EXPOSE 8080
CMD ["/app/.venv/bin/python", "-m", "worker.service"]
