# Current public product configuration. Never use VITE_ prefixes for secrets.
# Neon: server/worker only. Use the pooled TLS connection string.
DATABASE_URL=
# Worker only. Groq uses an expiring key and strict JSON schema responses.
GROQ_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-20b
MODEL_CONTEXT_TOKENS=12000
# Worker: project-scoped Railway token, never an account-wide API token.
RAILWAY_TOKEN=
RAILWAY_ENVIRONMENT_ID=
WORKER_WAKE_TOKEN=
# Vercel control plane: authenticated HTTP wake-up of Railway.
WORKER_URL=
# Public product: GitHub OAuth identity is separate from repository App access.
APP_URL=https://patchgoblin.vercel.app
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GitHub App's user OAuth grant confirms current selected-repository permissions.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=
# 32 random bytes encoded as 64 hex characters; server only.
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Optional operator publication details. No invented legal entity or contact.
OPERATOR_NAME=
LEGAL_CONTACT=
SUPPORT_URL=
# Optional: old Sites deployment redirects GETs and rejects new jobs after cutover.
PRODUCTION_URL=
MAX_MODEL_TOKENS=12000
MAX_STEPS=6
MAX_ATTEMPTS=2
JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=1
# Historical owner/PAT adapter only (scripts/local-server.ts and old Actions).
# None of these values authorizes the public product API.
GITHUB_TOKEN=
CONTROL_REPO=wauul/PatchGoblin
ALLOWED_REPOS=wauul/patchgoblin-lab
OWNER_LOGIN=wauul
LOCAL_USER=local-owner

# Sentry runtime: a separate DSN per service. Empty DSNs disable monitoring.
# Vercel API and Railway worker each set their own SENTRY_DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Canonical patchgoblin@<40-character git SHA>; Vercel/Railway git SHA is fallback.
SENTRY_RELEASE=
SENTRY_ENABLED=true
SENTRY_ERROR_SAMPLE_RATE=1
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_LOGS_ENABLED=false
SENTRY_LOG_SAMPLE_RATE=0.1
SENTRY_MAX_EVENTS_PER_MINUTE=60
# Existing Sentry cron monitor slug; project setup may generate a different slug.
SENTRY_RETENTION_MONITOR_SLUG=patchgoblin-daily-retention
# Explicit local/test override. Never enabled by default.
SENTRY_VERIFY=false

# Public frontend configuration (these are NOT privileged credentials).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ERROR_SAMPLE_RATE=1
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_LOGS_ENABLED=false
VITE_SENTRY_LOG_SAMPLE_RATE=0.1
VITE_SENTRY_MAX_EVENTS_PER_MINUTE=60
VITE_SENTRY_VERIFY=false
# Replay remains disabled unless both flags pass and the route is public.
VITE_SENTRY_REPLAY_ENABLED=false
VITE_SENTRY_REPLAY_PRIVACY_VERIFIED=false

# Extension build: public project DSN, packaged version included in release.
SENTRY_EXTENSION_DSN=
SENTRY_EXTENSION_ENVIRONMENT=development
SENTRY_EXTENSION_ENABLED=true
SENTRY_EXTENSION_ERROR_SAMPLE_RATE=1
SENTRY_EXTENSION_LOGS_ENABLED=false
SENTRY_EXTENSION_LOG_SAMPLE_RATE=0.1
SENTRY_EXTENSION_MAX_EVENTS_PER_MINUTE=60

# BUILD/CI ONLY. NEVER prefix this token with VITE_ or place it in runtime/VM secrets.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_FRONTEND=patchgoblin-frontend
SENTRY_PROJECT_API=patchgoblin-api
SENTRY_PROJECT_WORKER=patchgoblin-worker
SENTRY_PROJECT_EXTENSION=patchgoblin-extension
# Set true in release CI after configuring uploads; otherwise missing config warns.
SENTRY_REQUIRE_UPLOAD=false
