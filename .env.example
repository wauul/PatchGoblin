# Local server only. Never use VITE_ prefixes for secrets.
GITHUB_TOKEN=
CONTROL_REPO=wauul/PatchGoblin
ALLOWED_REPOS=wauul/patchgoblin-lab
OWNER_LOGIN=wauul
LOCAL_USER=local-owner
# Neon: server/worker only. Use the pooled TLS connection string.
DATABASE_URL=
# Worker only. Groq uses an expiring key and strict JSON schema responses.
GROQ_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-20b
MODEL_CONTEXT_TOKENS=12000
# Worker: project-scoped Railway token, never an account-wide API token.
RAILWAY_TOKEN=
RAILWAY_ENVIRONMENT_ID=
WORKER_WAKE_TOKEN=
# Vercel control plane: authenticated HTTP wake-up of Railway.
WORKER_URL=
# Public product: GitHub OAuth identity is separate from repository App access.
APP_URL=https://patchgoblin.vercel.app
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GitHub App's user OAuth grant confirms current selected-repository permissions.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=
# 32 random bytes encoded as 64 hex characters; server only.
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Optional operator publication details. No invented legal entity or contact.
OPERATOR_NAME=
LEGAL_CONTACT=
SUPPORT_URL=
# Optional: old Sites deployment redirects GETs and rejects new jobs after cutover.
PRODUCTION_URL=
MAX_MODEL_TOKENS=12000
MAX_STEPS=6
MAX_ATTEMPTS=2
JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=1
