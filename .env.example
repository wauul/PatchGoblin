# Local server only. Never use VITE_ prefixes for secrets.
GITHUB_TOKEN=
CONTROL_REPO=wauul/PatchGoblin
ALLOWED_REPOS=wauul/patchgoblin-lab
OWNER_LOGIN=wauul
LOCAL_USER=local-owner
# Worker: GitHub Actions injects a models:read GITHUB_TOKEN.
MODEL_BASE_URL=https://models.github.ai/inference
MODEL_NAME=openai/gpt-4.1-mini
MODEL_API_KEY=
MAX_MODEL_TOKENS=12000
MAX_STEPS=6
MAX_ATTEMPTS=2
JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=1
