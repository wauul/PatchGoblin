{
 "manifest_version":3,
 "name":"PatchGoblin — verified CI help",
 "version":"2.0.1",
 "description":"Open verified CI repair, creation and maintenance from GitHub. No GitHub tokens are stored in this extension.",
 "permissions":["activeTab"],
 "host_permissions":["https://patchgoblin.vercel.app/*"],
 "icons":{"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
 "action":{"default_popup":"popup.html","default_title":"Open PatchGoblin","default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png"}},
 "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'"}
}
